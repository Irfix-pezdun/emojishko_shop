# Скопируй в .env и заполни реальными значениями. .env никогда не коммить в git.

# Токен бота от @BotFather
BOT_TOKEN=

# Канал автора, на который нужно подписаться для бесплатного эмодзи
CHANNEL_USERNAME=@your_channel

# Личка автора — куда ведут кнопки "Написать напрямую" / после бесплатного эмодзи
AUTHOR_USERNAME=@your_username

# Числовой Telegram ID автора — нужен, чтобы бэкенд мог слать уведомления о новых
# заявках в личку. Получить: написать боту /myid после первого запуска.
AUTHOR_TELEGRAM_ID=

# Доп. админы бота (через запятую), помимо автора — необязательно
ADMIN_TELEGRAM_IDS=

# HTTPS-адрес задеплоенного фронтенда мини-аппа (нужен боту для кнопки /start)
WEBAPP_URL=

# Домены, с которых backend разрешает CORS-запросы. В деве можно "*", в проде —
# конкретный домен фронтенда через запятую.
CORS_ORIGINS=*

# ТОЛЬКО для локальной разработки вне Telegram (когда initData не приходит) — true
# отключает проверку подписи. В проде всегда false.
SKIP_INIT_DATA_CHECK=false

# URL backend для бота (команды /leads и refresh каталога)
API_BASE_URL=http://127.0.0.1:8000
